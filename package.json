{
  "name": "@fjacquet/nano-banana-mcp",
  "version": "3.0.1",
  "description": "MCP server for AI image generation and editing using Google Gemini (Flash + Pro models)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "nano-banana-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:run": "jest --ci",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "keywords": [
    "mcp",
    "nano-banana",
    "gemini",
    "image-generation",
    "ai",
    "google-ai",
    "claude-code",
    "cursor",
    "image-editing"
  ],
  "author": "fjacquet (forked from ConechoAI)",
  "license": "MIT",
  "homepage": "https://github.com/fjacquet/Nano-Banana-MCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjacquet/Nano-Banana-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/fjacquet/Nano-Banana-MCP/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitepress": "^2.0.0-alpha.18"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "@hono/node-server": "^2.0.5",
    "body-parser": "^2.3.0",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.4",
    "hono": "^4.12.27",
    "js-yaml": "^4.3.0",
    "minimatch": "^10.2.6",
    "protobufjs": "^7.6.5"
  }
}
